{
  "name": "nakwol-auth",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run cli:pack",
    "dev": "wrangler dev --port 8787",
    "predeploy": "npm run cli:pack",
    "deploy": "wrangler deploy",
    "test:unit": "tsx --test tests/worker/*.test.ts packages/connect-cli/test/*.test.mjs",
    "test": "npm run cli:pack && npm run test:unit",
    "typecheck": "npm run cli:pack && tsc --noEmit",
    "cli:pack": "node scripts/build-connect-cli-package.mjs",
    "db:migrate:local": "wrangler d1 migrations apply nakwol-auth --local",
    "db:seed:local": "wrangler d1 execute nakwol-auth --local --file=./scripts/dev-seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply nakwol-auth --remote",
    "test:managed": "node scripts/managed-gate-smoke.mjs"
  },
  "dependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240101.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.119.0"
  }
}
